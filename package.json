  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "pnpm run lint && NODE_ENV=production pnpm run build && pnpm run test:coverage",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:multiuser": "tsx prisma/seed-multiuser.ts",
    "db:studio": "prisma studio",
    "docker:dev": "docker compose up -d",
    "docker:dev:stop": "docker compose down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:stop": "docker compose -f docker-compose.prod.yml down"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
