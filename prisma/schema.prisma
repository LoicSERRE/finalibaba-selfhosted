generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  REAL_ESTATE
  MEAL_VOUCHER
  CRYPTO
  AUTOMOBILE
  LOAN
}

enum HoldingCurrency {
  EUR
  USD
  GBP
  CHF
}

enum TaxTreatment {
  EXEMPT   // never taxed on gains (foreign ISA/Roth IRA equivalents)
  DEFERRED // taxed only on withdrawal (PER/401k) - not taxed for latent/net-worth purposes today
  TAXABLE  // taxed now, at this account's own taxRatePct
}

// ── v2.0 multi-user ─────────────────────────────────────────────────────────
// See CLAUDE.md's "Multi-user architecture" for the full design. Key
// invariants:
// - A fixed-id owner row (OWNER_USER_ID = "user-owner",
//   lib/auth-context.ts) is created by the v2 migration itself and every
//   pre-existing row is backfilled to it. Mono mode (AUTH_ENABLED unset)
//   resolves the viewer to this row without any login - one uniform code
//   path, no nullable-owner states, and switching an existing instance to
//   multi-user later attaches its history to the admin automatically by
//   construction (the bootstrap screen just sets credentials ON this row).
// - Every userId column below carries @default("user-owner") during the
//   foundation phase. For Account and SyncLog the default is PERMANENT and
//   load-bearing: sync/db.py INSERTs those two tables via raw SQL with
//   explicit column lists that don't know about userId - the DB-level
//   default is what keeps the Python sidecar working with zero code
//   changes, and env-synced (LCL/TR) data belonging to the owner is
//   exactly the intended semantics. For every other table the default is
//   scaffolding to be dropped once all app-side creates pass an explicit
//   userId (isolation phase).

enum UserRole {
  ADMIN  // full instance control: user management, invitations, backup/restore
  MEMBER // a regular user - full control over their own portfolio only
}

model User {
  id           String   @id @default(cuid()) // owner row uses the fixed id "user-owner"
  // Null until the bootstrap/invitation flow completes - the migration
  // creates the owner with no credentials at all (mono mode never needs
  // them). Unique once set; Postgres allows multiple NULLs so this doesn't
  // constrain un-bootstrapped rows.
  username     String?  @unique
  displayName  String?
  // bcrypt. Null = this user can't log in with a DB password yet. For the
  // owner specifically, the env AUTH_PASSWORD/AUTH_PASSWORD_HASH fallback
  // in lib/auth.ts applies ONLY while this is null - once set, the DB hash
  // wins absolutely and env credentials are ignored (see authorize()).
  passwordHash String?
  role         UserRole @default(MEMBER)
  // Per-user TOTP - moved from the UserSettings singleton (fields there are
  // now vestigial, see UserSettings). Same plaintext-secret/bcrypt-backup-
  // codes trust model documented on the original fields.
  totpSecret      String?
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([])
  // Per-user app-lock (WebAuthn) - moved from the UserSettings singleton
  // (vestigial there too). The WebAuthn userHandle becomes this row's id,
  // replacing the old hardcoded single-instance constant.
  appLockEnabled   Boolean @default(false)
  appLockChallenge String?
  createdAt DateTime @default(now())

  institutions       Institution[]
  accounts           Account[]
  categories         Category[]
  goals              Goal[]
  alertRules         AlertRule[]
  shareLinks         ShareLink[]
  apiKeys            ApiKey[]
  pushSubscriptions  PushSubscription[]
  appLockCredentials AppLockCredential[]
  syncLogs           SyncLog[]
  syncFailureStates  SyncFailureState[]
  settings           UserSettings?
  coOwnedAccounts    AccountCoOwner[]
  invitationsCreated Invitation[]
  grantsGiven        PortfolioGrant[] @relation("grantor")
  grantsReceived     PortfolioGrant[] @relation("grantee")
}

// Single-use, admin-generated invitation (see CLAUDE.md - the admin never
// chooses anyone's password; the invitee sets their own on arrival, on the
// same screen component as the first-boot bootstrap flow). Grants zero
// access until used; expired/used tokens are rejected server-side.
model Invitation {
  id              String    @id @default(cuid())
  token           String    @unique
  createdBy       User      @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  createdByUserId String
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
}

// Instance-level (not per-user) settings. VAPID keys identify the SERVER to
// push services, not a person - they moved here from the UserSettings
// singleton (vestigial there), where they only ever made sense while the
// whole app was single-user. Regenerating them would invalidate every
// registered PushSubscription across all users, same warning as before.
model InstanceSettings {
  id              String  @id @default("singleton")
  vapidPublicKey  String?
  vapidPrivateKey String?
}

// Account-level co-ownership (joint Livret A, an account managed for a
// child...) - the co-owned account appears in each co-owner's portfolio
// pointing at the same underlying rows, no duplication. The account's own
// Account.userId stays its primary owner; rows here add further users with
// full write access. `role` is forward-compat (only OWNER exists today).
model AccountCoOwner {
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("OWNER")
  createdAt DateTime @default(now())

  @@id([accountId, userId])
}

// Whole-portfolio read-only grant ("invités lecture seule") - the grantee
// can VIEW everything in the grantor's portfolio (own + co-owned accounts)
// but never write, and never derive artifacts from it (share links, API
// keys and alerts are always scoped to a user's own portfolio, see
// lib/auth-context.ts's baseAccountIds vs viewAccountIds split). `role` is
// forward-compat (only READ exists today).
model PortfolioGrant {
  grantor       User     @relation("grantor", fields: [grantorUserId], references: [id], onDelete: Cascade)
  grantorUserId String
  grantee       User     @relation("grantee", fields: [granteeUserId], references: [id], onDelete: Cascade)
  granteeUserId String
  role          String   @default("READ")
  createdAt     DateTime @default(now())

  @@id([grantorUserId, granteeUserId])
}

model Institution {
  id                      String    @id @default(cuid())
  // Unique per user, not globally - two users can each have their own "LCL".
  name                    String
  logoUrl                 String?
  accounts                Account[]
  createdAt               DateTime  @default(now())
  gocardlessInstitutionId String?   // e.g. LCL_CRLYFRPP
  gocardlessRequisitionId String?   // set after OAuth completion
  woobModule              String?   // Woob backend module name, e.g. "bnporc", "caissedepargne"
  woobLogin               String?
  woobPassword            String?
  userId                  String    @default("user-owner")
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model Account {
  id                  String              @id @default(cuid())
  name                String
  type                AccountType
  institutionId       String?             // nullable - cars and loans may have no associated bank
  // onDelete: Cascade - deleteInstitution's own confirmation dialog
  // (messages/*.json's deleteInstitution.description) explicitly promises
  // "the institution and all its associated accounts will be permanently
  // deleted". Without this, Prisma's implicit default for an optional
  // relation is SetNull, not Cascade - deleting an Institution silently
  // orphaned its Accounts (institutionId -> null) instead of deleting them,
  // leaving their HistoricalBalance/Transaction/Holding history intact but
  // invisible from Settings (no Institution row left to list them under)
  // while still counted in net worth, /accounts, and every other page -
  // found in production when a "fresh install" test still showed a
  // supposedly-deleted LCL account's balance on the dashboard. Every other
  // FK in this schema pointing at Account already writes onDelete: Cascade
  // explicitly; this was the one left on Prisma's silent default instead.
  institution         Institution?        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  manualValueCents    BigInt?
  liabilityCents      BigInt?
  purchasePriceCents  BigInt?             // AUTOMOBILE: original purchase price
  insuranceMonthlyCents BigInt?           // AUTOMOBILE + LOAN: monthly insurance premium
  investmentSubtype   String?             // "PEA" | "CTO" - only for INVESTMENT type
  investmentStartDate DateTime?           // Investment start date (manual entry)
  taxTreatment        TaxTreatment        @default(TAXABLE) // INVESTMENT/CRYPTO only - see TaxTreatment
  taxRatePct          Float?              // 0-1 ratio, meaningful only when taxTreatment = TAXABLE
  loanAmountCents     BigInt?             // LOAN: initial borrowed amount
  loanTaeg            Float?              // LOAN: annual interest rate in % (e.g. 5.47)
  loanDurationMonths  Int?                // LOAN: total duration in months
  loanDeferralMonths  Int?                // LOAN: deferral period in months (0 = none)
  loanStartDate       DateTime?           // LOAN: repayment start date
  // LOAN: dedup flag for the "nearly paid off" alert - one-way, a loan only
  // crosses the threshold once. See lib/domain/alerts.ts.
  loanPaidOffAlertSent Boolean            @default(false)
  holdings            Holding[]
  history             HistoricalBalance[]
  transactions        Transaction[]
  recurringTransactions RecurringTransaction[]
  incomeEvents        IncomeEvent[]
  sales               Sale[]
  alertRules          AlertRule[]
  goals               Goal[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  gocardlessAccountId String?             @unique
  // Deliberately GLOBALLY unique, not per-user, in v2.0 - see CLAUDE.md's
  // "Multi-user architecture". The env-driven sources (LCL/Trade Republic)
  // are the owner's alone, and TR in particular writes fixed ids
  // ("tr:cash", "tr:cto"...) that only one user can ever produce; Woob ids
  // are already namespaced by an institution cuid. The one real collision
  // left - two users connecting the same physical bank account via
  // GoCardless - is caught at requisition-link time with an explicit
  // "already connected by another user" error rather than silently
  // merging or dropping data.
  syncId              String?             @unique // e.g. "lcl:FR76XXXX" or "tr:ISIN"
  // PERMANENT default (unlike the scaffolding defaults elsewhere):
  // sync/db.py's raw-SQL INSERT doesn't know about this column, and
  // env-synced accounts belonging to the owner is the intended semantics.
  userId              String              @default("user-owner")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  coOwners            AccountCoOwner[]

  @@index([userId])
}

model Holding {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticker         String
  name           String?
  quantity       Decimal  @db.Decimal(24, 10)
  lastPriceCents BigInt   @default(0)
  costBasisCents BigInt?  // total acquisition cost in cents (null = unknown)
  targetPct      Float?   // 0-1 ratio, target share of the account's total value - null means not part of the rebalancing plan
  currency             HoldingCurrency @default(EUR)
  nativePriceCents     BigInt?         // price as entered, in `currency` - null when currency = EUR (lastPriceCents IS the native price)
  nativeCostBasisCents BigInt?         // cost basis as entered, in `currency` - same null convention
  fxRateToEur          Float?          // EUR per 1 unit of `currency`, captured at entry time - null when currency = EUR
  alertRules     AlertRule[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([accountId, ticker])
}

model SyncLog {
  id        String   @id @default(cuid())
  source    String   // "lcl" | "trade_republic" | "woob:<institutionId>"
  status    String   // "success" | "error" | "auth_required"
  message   String?
  createdAt DateTime @default(now())
  // PERMANENT default, same reason as Account.userId: sync/db.py writes
  // this table via raw SQL. A Woob-source log belongs to the institution's
  // owner; the env-driven lcl/trade_republic sources belong to the owner.
  userId    String   @default("user-owner")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([source, createdAt])
  @@index([userId, source, createdAt])
}

// Tracks, per sync source, whether it's currently in an unresolved broken
// streak - one row means "source has been failing since brokenSince, last
// alerted about it at lastAlertedAt". Deleted the moment that source syncs
// successfully again, so the *next* failure (if any) starts a brand new
// streak and alerts immediately rather than staying silently suppressed
// forever. Exists so checkSyncFailures() alerts once per streak (plus a
// reminder every REMINDER_INTERVAL_MS while it's still broken) instead of
// once per failed sync attempt - confirmed the hard way that the latter
// sends hundreds of emails within minutes once a source has been broken for
// a while (every failed attempt, whether from the 4h cron or repeated
// AutoSync-triggered retries, used to write its own SyncLog row that all
// got alerted on the very first check after being unblocked).
// Keyed per (user, source), not source alone: two users each syncing their
// own LCL would otherwise share one dedup row, so one user's alert would
// silence the other's. App-written only - sync/db.py never touches this
// table, so unlike Account/SyncLog it needs no DB-level default.
model SyncFailureState {
  source        String
  brokenSince   DateTime @default(now())
  lastAlertedAt DateTime @default(now())
  userId        String   @default("user-owner")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, source])
}

enum AlertRuleKind {
  ACCOUNT_BALANCE
  BUDGET_OVERRUN
  ACCOUNT_OVERDRAFT
  INVESTMENT_VALUE
  HOLDING_PRICE
  UNREALIZED_GAIN
  REBALANCING_DRIFT
  NEW_TRANSACTION
}

enum GainUnit {
  PERCENT
  AMOUNT
}

// NEW_TRANSACTION only - null means "both debits and credits", not "unset".
enum TransactionAlertDirection {
  DEBIT
  CREDIT
}

// User-defined alert rules - a parallel mechanism alongside the 3 fixed
// v1.5 triggers on UserSettings (netWorthAlertThresholdCents et al.), which
// stay untouched - see CLAUDE.md's "Alerts & webhooks". One row per rule;
// `kind` decides which field group below is meaningful, same
// type-conditional-nullable-fields convention Account already uses for its
// LOAN/INVESTMENT-only fields - just shared across more than two kinds here.
model AlertRule {
  id      String        @id @default(cuid())
  kind    AlertRuleKind
  active  Boolean       @default(true)
  // Optional text appended to the generated alert body - null means just
  // the auto-generated sentence.
  message String?

  // Shared by ACCOUNT_BALANCE, ACCOUNT_OVERDRAFT, INVESTMENT_VALUE, and
  // HOLDING_PRICE, plus UNREALIZED_GAIN when gainUnit = AMOUNT - all the
  // exact same "current cents value crosses balanceThresholdCents"
  // edge-triggered shape (evaluateAccountBalanceAlert), just a different
  // source for "current" per kind (fiat balance, investment/crypto market
  // value, a single holding's price, or a computed gain) - kept as shared
  // columns rather than one pair per kind to avoid schema bloat for what's
  // mathematically the same comparison every time. The "balance"-flavored
  // names predate this reuse (ACCOUNT_BALANCE was the only kind that had
  // them) and were kept as-is rather than renamed, to avoid a risky
  // column-rename migration against already-deployed self-hosted installs'
  // real rule data. accountId is only ever null for UNREALIZED_GAIN (null =
  // aggregate across every investment/crypto account); every other kind
  // above requires a specific account, enforced in the create/update
  // action. onDelete: Cascade (not Transaction/RecurringTransaction's
  // SetNull-on-Category convention) - a rule whose account/holding/category
  // was deleted has no purpose left; a nulled-out rule would sit dead in
  // the list instead of just disappearing with it.
  accountId             String?
  account               Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balanceThresholdCents BigInt?
  // Edge-triggered dedup, same semantics as UserSettings.netWorthAlertLastAbove
  // (null = never evaluated, fires only when the crossing direction flips).
  balanceLastAbove      Boolean?

  // HOLDING_PRICE - a specific position's lastPriceCents (already
  // EUR-converted at entry time for foreign-currency holdings, see
  // Holding.fxRateToEur) crosses balanceThresholdCents, reusing the two
  // fields above for the actual comparison/dedup. Also the account/holding
  // scope for REBALANCING_DRIFT below (same picker shape - one specific
  // position), which reuses gainThresholdPct/balanceLastAbove instead of
  // this pair, since drift is a points comparison, not a cents one.
  holdingId String?
  holding   Holding? @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  // UNREALIZED_GAIN only, when gainUnit = PERCENT - gain/costBasis*100
  // crosses this instead of balanceThresholdCents. A separate field rather
  // than overloading balanceThresholdCents as "either cents or a raw
  // percent number", so a stored value's unit is never ambiguous.
  // Also reused by REBALANCING_DRIFT (gainUnit stays null there - it's the
  // only other kind using this column) to mean "drift points from target",
  // not a gain percentage - same rationale as balanceThresholdCents being
  // reused across dissimilarly-named kinds above: it's mathematically the
  // same edge-triggered "float crosses a threshold" comparison
  // (evaluatePercentAlert), just fed |driftPts| instead of a gain %.
  gainUnit         GainUnit?
  gainThresholdPct Float?

  // BUDGET_OVERRUN only. Threshold comes from Category.budgetCents itself,
  // not duplicated here.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Re-arms every calendar month, unlike the one-way loan flag or the
  // two-way balance/net-worth flip - stores which period ("YYYY-MM", UTC)
  // this rule last fired for, so a rule that fired in July can fire again
  // in August even though spend never "un-overran" in between.
  budgetOverrunLastFiredPeriod String?

  // NEW_TRANSACTION only (v1.17) - the one kind that isn't a threshold
  // crossing, so it can't reuse balanceLastAbove's edge-trigger dedup.
  // accountId above is reused as the scope (null = every account, same
  // "null is valid input" precedent as UNREALIZED_GAIN's aggregate mode);
  // balanceThresholdCents above is reused as a minimum absolute amount to
  // alert on (null = no minimum), not a crossing value.
  transactionDirection TransactionAlertDirection?
  // The cursor: transactions with createdAt after this are "new" and
  // eligible to fire. null means never evaluated - the rule's first-ever
  // check sets this to the latest already-matching transaction's createdAt
  // without firing (same never-fire-on-first-check convention as
  // netWorthAlertLastAbove), so creating the rule doesn't dump an account's
  // entire history into one notification. Deliberately NOT reset when
  // balanceThresholdCents/transactionDirection are edited later, unlike a
  // crossing threshold's own dedup flag - this cursor means "already told
  // the user about this transaction," which stays true regardless of a
  // later filter change.
  lastNotifiedTransactionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // Direct owner, not transitive via accountId: accountId is legitimately
  // null for UNREALIZED_GAIN ("across every investment/crypto account") and
  // NEW_TRANSACTION ("every account"), which must mean "every account *I*
  // can see", so the rule needs its own owner regardless.
  userId    String   @default("user-owner")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([active])
  @@index([userId])
}

// One row per user-defined savings goal (v1.14) - replaces
// UserSettings.savingsGoalCents's single global figure, which stays in
// the schema unused (see that field's own comment) rather than being
// dropped, per this repo's non-destructive-migration convention
// (taxRatePea/Cto/Crypto follow the same pattern for a superseded column).
//
// accountId: null means the goal tracks total net worth (grossAssets -
// totalLiabilities) - the exact math the old single global goal always
// did. accountId: <id> means the goal tracks that one account's current
// value instead. Both are equally normal, everyday choices - unlike
// AlertRule's UNREALIZED_GAIN kind (where null accountId is the only
// option that kind offers), a null accountId here is not a fallback, it's
// "track my whole net worth" as a first-class goal shape.
//
// onDelete: Cascade (not SetNull) on accountId - same reasoning as
// AlertRule's own accountId FK: a null accountId means something
// different here ("track total net worth"), so silently falling back to
// that when a linked account is deleted would silently change what the
// goal measures instead of just removing the goal that no longer makes
// sense. LOAN accounts are excluded from the picker entirely (see
// lib/actions/goals.ts) - a loan is a liability, not something to save
// toward - matching lib/domain/analytics.ts's own assetRows exclusion of
// LOAN accounts for the same reason, so the picker and the value-lookup
// source stay in agreement by construction.
model Goal {
  id          String    @id @default(cuid())
  name        String
  targetCents BigInt
  targetDate  DateTime?
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  // Direct owner for the same reason as AlertRule: a null accountId means
  // "track my whole net worth", which is inherently per-user.
  userId      String    @default("user-owner")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model HistoricalBalance {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balanceCents BigInt
  recordedAt   DateTime @default(now())

  @@index([accountId, recordedAt])
}

model Transaction {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  syncId      String    @unique // woob transaction id - used for deduplication
  date        DateTime
  label       String
  amountCents BigInt    // positive = credit, negative = debit
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // GoCardless-only (PSD2's Berlin Group schema) - the card network's own
  // 4-digit merchant classification, when the account's bank actually
  // populates it (optional per the spec, so this is null for most
  // transactions - Woob/Trade Republic/CSV import never set it, they have
  // no equivalent field at all). See "Automatic categorization" in
  // CLAUDE.md: a more authoritative signal than free-text label matching
  // when present, since it's assigned by the card network at merchant
  // registration time rather than guessed from a label substring.
  merchantCategoryCode String?
  createdAt   DateTime  @default(now())
  // Reverse side of IncomeEvent.transactionId - lets "Mark as income"
  // (see IncomeEvent below) tell whether this transaction already has one,
  // so the same real-world payment can't be double-recorded.
  incomeEvent IncomeEvent?
  // Set by detectInternalTransferPairs (lib/domain/internal-transfers.ts)
  // when this transaction is matched with an opposite-signed transaction
  // of the same absolute amount on a different account within a few days -
  // a real gap found in production: a French bank's generic transfer
  // label ("VIREMENT SEPA") is reused for both internal transfers and real
  // external payments with no way to tell them apart from text alone, so
  // an internal transfer was getting auto-categorized as income. Once
  // flagged true, autoCategorizeTransactions never assigns it a category
  // automatically (it isn't real income or spending) - the flag doesn't
  // block a manual categorization, only the automatic sources.
  isInternalTransfer Boolean @default(false)
  // A transaction with splits has categoryId = null at the top level - the
  // category breakdown lives entirely in these rows instead. Enforced by
  // setTransactionSplits (lib/actions/transaction-splits.ts), never a raw
  // write. See CLAUDE.md's "Split transactions" for why every
  // "categoryId: null" query elsewhere in the app that means "genuinely
  // uncategorized" also needs a "splits: { none: {} }" guard alongside it.
  splits TransactionSplit[]

  @@index([accountId, date])
  @@index([categoryId])
  @@index([isInternalTransfer])
}

// One category's portion of a split transaction - see CLAUDE.md's "Split
// transactions". amountCents is signed, same convention as
// Transaction.amountCents; every split row for one transaction must sum
// exactly to that transaction's own amountCents (validated in
// setTransactionSplits, not enforced by the schema itself). categoryId is
// nullable with onDelete: SetNull, same as Transaction.categoryId - a
// split whose category gets deleted keeps its allocated amount (still
// counts toward the transaction's total) but drops out of any
// category-specific total, rather than losing the split breakdown outright.
model TransactionSplit {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amountCents   BigInt
  createdAt     DateTime    @default(now())

  @@index([transactionId])
  @@index([categoryId])
}

// EXPENSE is the default and by far the more common case (this app's
// budgeting concept has always meant spending) - INCOME is explicit,
// chosen at creation, never inferred from a category's transaction
// history. /budgets only ever lists EXPENSE categories (a "budget" cap
// has no meaning for income); /income lists INCOME categories alongside
// its own IncomeEvent-based dividend/interest tracking - see CLAUDE.md's
// "Interest & dividend income tracking" for why those stay two separate,
// parallel mechanisms rather than merging into one.
enum CategoryKind {
  EXPENSE
  INCOME
}

model Category {
  id                      String                 @id @default(cuid())
  // Unique per user, not globally - each user has their own category set.
  // On a co-owned account, whichever co-owner categorizes a transaction
  // does so with THEIR category (last write wins); budgets therefore
  // aggregate strictly per category owner. See CLAUDE.md's "Multi-user
  // architecture" for why that beats a per-user assignment junction.
  name                    String
  color                   String                 // hex, e.g. "#6366f1"
  kind                    CategoryKind           @default(EXPENSE)
  budgetCents             BigInt?                // monthly envelope - null means no budget set, and meaningless for an INCOME category (no cap concept for income)
  budgetRolloverEnabled   Boolean                @default(false) // unused envelope carries into next month instead of resetting to zero - meaningless without budgetCents set, same as above
  budgetRolloverEnabledAt DateTime?              // anchor for the carry computation - only months from here onward count, so re-enabling after a pause doesn't resurrect a stale carry. Reset to null whenever rollover is turned off; set to now() on the off->on transition, left untouched while already on (see lib/actions/categories.ts)
  transactions            Transaction[]
  transactionSplits       TransactionSplit[]
  recurringTransactions   RecurringTransaction[]
  alertRules              AlertRule[]
  createdAt               DateTime               @default(now())
  userId                  String                 @default("user-owner")
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id            String             @id @default(cuid())
  accountId     String
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label         String
  amountCents   BigInt             // positive = income, negative = expense
  categoryId    String?
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency     RecurringFrequency @default(MONTHLY)
  intervalCount Int                @default(1) // e.g. frequency=WEEKLY, intervalCount=2 → every 2 weeks
  anchorDate    DateTime           // a real known occurrence - day/weekday/month is derived from this
  active        Boolean            @default(true)
  autoDetected  Boolean            @default(false) // created by confirming a detected suggestion vs manually
  createdAt     DateTime           @default(now())

  @@index([accountId])
}

enum IncomeType {
  DIVIDEND
  INTEREST
}

model IncomeEvent {
  id               String     @id @default(cuid())
  accountId        String
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type             IncomeType
  ticker           String?    // e.g. "AAPL" - ties a DIVIDEND to a specific holding; null for INTEREST or an unattributed dividend
  amountCents      BigInt     // gross amount received
  taxWithheldCents BigInt?    // foreign withholding tax (e.g. 15% US treaty rate) - null means none withheld
  date             DateTime
  createdAt        DateTime   @default(now())
  // Set when this row was created via "Mark as income" from an actual
  // Transaction row (amount/date pre-filled from it) rather than typed
  // from scratch - null for pre-existing rows and for anyone who still
  // prefers the manual /income form. @unique so the same real payment can't
  // be marked as income twice. onDelete: SetNull, not Cascade: deleting the
  // source transaction (or its account) shouldn't destroy an already
  // fiscally-relevant income record - the record just loses its
  // provenance link.
  transactionId    String?     @unique
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([accountId, date])
}

model Sale {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticker         String
  quantity       Decimal  @db.Decimal(24, 10)
  proceedsCents  BigInt   // gross sale proceeds
  costBasisCents BigInt   // cost basis of the sold portion (average-cost method)
  date           DateTime
  createdAt      DateTime @default(now())

  @@index([accountId, date])
}

// One row per user as of v2.0 (was a single "singleton" row). The legacy
// singleton row is re-pointed to the owner by the v2 migration, keeping its
// id so nothing that stored a reference to it breaks.
model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique @default("user-owner")
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salaryNetCents       BigInt   @default(0)
  monthlyExpensesCents BigInt   @default(0)
  // VESTIGIAL as of v1.14 - superseded by the Goal model (see its own
  // comment). Kept, not dropped, per this repo's non-destructive-migration
  // convention; no longer read or written anywhere in app code.
  savingsGoalCents     BigInt   @default(5000000)
  monthlySavedCents    BigInt   @default(0)
  taxRatePea           Float    @default(0.172)
  taxRateCto           Float    @default(0.314)
  taxRateCrypto        Float    @default(0.314)
  // VESTIGIAL as of v2.0 - TOTP moved to User (per-user 2FA). Kept, not
  // dropped, per this repo's non-destructive-migration convention; the v2
  // migration copies these values onto the owner's User row. No longer read
  // or written anywhere in app code.
  totpSecret           String?
  totpEnabled          Boolean  @default(false)
  totpBackupCodes      String[] @default([])
  // VESTIGIAL as of v2.0 - app-lock moved to User (per-user), same
  // non-destructive convention as the TOTP fields above; the v2 migration
  // copies these onto the owner's User row.
  //
  // (Original rationale, kept for context.) App-lock (WebAuthn) -
  // deliberately independent of AUTH_ENABLED/totp
  // above, same "independent of AUTH_ENABLED" precedent as ShareLink: a
  // fast local unlock for an already-installed, already-trusted PWA, not a
  // replacement for the server-side session AUTH_ENABLED provides.
  // appLockChallenge is transient per-ceremony state (registration or
  // authentication, never both at once for a single-user app) - same
  // "single reusable slot, safe to overwrite an abandoned attempt" trust
  // model as totpSecret above during setup.
  appLockEnabled       Boolean  @default(false)
  appLockChallenge     String?
  // Alert channels - blank/null = that channel is disabled, same "leave
  // blank to disable" convention as every optional integration in
  // .env.example. smtpPassword is plaintext, same trust model as
  // totpSecret above.
  ntfyTopicUrl         String?
  // Bearer token for a self-hosted ntfy server with auth-default-access=deny-all
  // (see README's "Self-hosted alerts" section) - blank when pointed at the
  // public ntfy.sh anonymously, which has no auth to send.
  ntfyAuthToken        String?
  alertEmailTo         String?
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  smtpPassword         String?
  smtpFrom             String?
  // Independent on/off per channel, layered on top of "is it configured"
  // above - a user with both ntfy and email filled in couldn't previously
  // choose to receive through only one of them (dispatchAlert fanned out to
  // every configured channel unconditionally). Default true so an existing
  // install with a channel already configured keeps firing through it
  // exactly as before; unlike the config fields themselves, these two are
  // meaningless (never read) when their own channel isn't configured at all.
  ntfyEnabled          Boolean  @default(true)
  emailAlertsEnabled   Boolean  @default(true)
  // Web Push - a 3rd alert channel alongside ntfy/email, same independent
  // on/off toggle convention as the two above. vapidPublicKey/vapidPrivateKey
  // are generated once by the app itself on first use (lib/services/
  // notifications.ts's getOrCreateVapidKeys()), never something a
  // self-hoster configures - same "app generates it, not the user"
  // precedent as totpSecret. Meaningless (never read) until at least one
  // PushSubscription row exists, same "meaningless when unconfigured"
  // convention as ntfyEnabled/emailAlertsEnabled above.
  webPushEnabled       Boolean  @default(true)
  // VESTIGIAL as of v2.0 - VAPID keys identify the SERVER, not a person,
  // so they moved to InstanceSettings. Kept per the non-destructive
  // convention; the v2 migration copies them there. Regenerating them
  // would still invalidate every registered subscription, now across all
  // users.
  vapidPublicKey       String?
  vapidPrivateKey      String?
  // Net worth alert - blank threshold = disabled. netWorthAlertLastAbove is
  // dedup state (null = never evaluated yet): the alert only fires when the
  // crossing direction actually flips, not on every check while it stays
  // above/below.
  netWorthAlertThresholdCents BigInt?
  netWorthAlertLastAbove      Boolean?
  // Per-trigger opt-out for the two triggers that don't already have one -
  // net worth's off-switch is its blank threshold above. Default true so
  // existing installs keep today's behavior (both were always-on before
  // these fields existed).
  loanAlertsEnabled        Boolean  @default(true)
  syncFailureAlertsEnabled Boolean  @default(true)
  // Degradation alert for the Analytics sector-exposure chart's Yahoo Finance
  // crumb-based ETF path (see CLAUDE.md's "Full sector-exposure breakdown") -
  // default false, unlike the two toggles above, since this is a brand new
  // notification category with no pre-existing always-on behavior to
  // preserve for existing installs.
  sectorDataAlertsEnabled Boolean  @default(false)
  updatedAt            DateTime @updatedAt
}

// Plaintext token, same trust model as UserSettings.totpSecret above - the
// point of a share link is being re-copied/re-shared later, so hashing it
// would force a "copy now or lose it forever" UX. Unguessability comes from
// entropy (32 random bytes, see lib/domain/share-links.ts), not from hiding
// it server-side.
model ShareLink {
  id             String    @id @default(cuid())
  token          String    @unique
  label          String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  lastAccessedAt DateTime?
  // Deliberate opt-in, default false: both surface more detail than the
  // dashboard-only view this link originally shipped with, and this link
  // may be reachable from the public internet - see "Read-only share links"
  // in CLAUDE.md. Set once at creation (createShareLink), no edit path -
  // same convention as label/expiresAt above.
  includeHoldings     Boolean @default(false)
  includeTransactions Boolean @default(false)
  // The link exposes exactly its owner's OWN portfolio (their accounts +
  // co-owned ones), never a portfolio merely granted to them for reading -
  // otherwise a read-only guest could mint a public link over someone
  // else's data that outlives the grant. See baseAccountIds() in
  // lib/auth-context.ts.
  userId              String  @default("user-owner")
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Read-only REST API key (Settings -> API, see CLAUDE.md's "Public REST
// API") - deliberately its own model, not a reuse of ShareLink, even though
// both are unguessable-entropy bearer tokens: a ShareLink is meant for a
// specific other person to view a specific page, an ApiKey is meant for the
// owner's own tools (Home Assistant, a custom dashboard) to call a small
// set of JSON endpoints - different audience, different revocation
// granularity, conflating them would make either one's semantics fuzzy.
// token is plaintext, same trust model as ShareLink.token/
// UserSettings.totpSecret/Institution.woobPassword - the DB isn't hardened
// against server compromise, so hashing this one field buys little, and
// unlike a "shown once" GitHub-style token it needs to stay re-copyable
// (Settings -> API keeps a Copy button, no re-generation ceremony).
model ApiKey {
  id         String    @id @default(cuid())
  token      String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  // Same own-portfolio-only scoping rule as ShareLink above.
  userId     String    @default("user-owner")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per registered WebAuthn authenticator (Settings -> "Verrouillage
// de l'appli") - a device's platform authenticator (Touch ID, Windows
// Hello, Android biometric) gets its own key pair, so a user with the PWA
// installed on both a phone and a laptop registers two separate rows here,
// each independently revocable. publicKey/counter are the standard WebAuthn
// verification pair (COSE public key + signature counter for replay
// detection) - never a secret to protect the way totpSecret is, the public
// key can't be used to authenticate on its own without the matching private
// key that never leaves the device's secure hardware.
model AppLockCredential {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  deviceLabel  String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?
  // As of v2.0 the WebAuthn userHandle is this user's id rather than a
  // hardcoded instance-wide constant, so each user registers and revokes
  // their own authenticators independently.
  userId       String    @default("user-owner")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// One row per browser/device subscribed to Web Push (Settings -> "Alertes"),
// a 3rd alert channel alongside ntfy/email - see CLAUDE.md's "Alerts &
// webhooks". endpoint/p256dh/auth are exactly what the browser's own
// PushSubscription.toJSON() returns from pushManager.subscribe() - not a
// secret to protect (an attacker needs the matching VAPID private key,
// stored once on UserSettings, to actually push through it), but unique
// per browser+device the same way AppLockCredential is, so a phone and a
// laptop each get their own independently-revocable row.
model PushSubscription {
  id          String    @id @default(cuid())
  // Still globally unique: a browser endpoint is one physical destination,
  // so it can only belong to one user at a time. The subscribe action
  // re-points an existing row to the current user rather than failing,
  // which is the correct behavior for a shared browser.
  endpoint    String    @unique
  p256dh      String
  auth        String
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  userId      String    @default("user-owner")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
