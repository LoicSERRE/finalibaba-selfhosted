generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  REAL_ESTATE
  MEAL_VOUCHER
  CRYPTO
  AUTOMOBILE
  LOAN
}

enum HoldingCurrency {
  EUR
  USD
  GBP
  CHF
}

enum TaxTreatment {
  EXEMPT   // never taxed on gains (foreign ISA/Roth IRA equivalents)
  DEFERRED // taxed only on withdrawal (PER/401k) - not taxed for latent/net-worth purposes today
  TAXABLE  // taxed now, at this account's own taxRatePct
}

model Institution {
  id                      String    @id @default(cuid())
  name                    String    @unique
  logoUrl                 String?
  accounts                Account[]
  createdAt               DateTime  @default(now())
  gocardlessInstitutionId String?   // e.g. LCL_CRLYFRPP
  gocardlessRequisitionId String?   // set after OAuth completion
  woobModule              String?   // Woob backend module name, e.g. "bnporc", "caissedepargne"
  woobLogin               String?
  woobPassword            String?
}

model Account {
  id                  String              @id @default(cuid())
  name                String
  type                AccountType
  institutionId       String?             // nullable - cars and loans may have no associated bank
  // onDelete: Cascade - deleteInstitution's own confirmation dialog
  // (messages/*.json's deleteInstitution.description) explicitly promises
  // "the institution and all its associated accounts will be permanently
  // deleted". Without this, Prisma's implicit default for an optional
  // relation is SetNull, not Cascade - deleting an Institution silently
  // orphaned its Accounts (institutionId -> null) instead of deleting them,
  // leaving their HistoricalBalance/Transaction/Holding history intact but
  // invisible from Settings (no Institution row left to list them under)
  // while still counted in net worth, /accounts, and every other page -
  // found in production when a "fresh install" test still showed a
  // supposedly-deleted LCL account's balance on the dashboard. Every other
  // FK in this schema pointing at Account already writes onDelete: Cascade
  // explicitly; this was the one left on Prisma's silent default instead.
  institution         Institution?        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  manualValueCents    BigInt?
  liabilityCents      BigInt?
  purchasePriceCents  BigInt?             // AUTOMOBILE: original purchase price
  insuranceMonthlyCents BigInt?           // AUTOMOBILE + LOAN: monthly insurance premium
  investmentSubtype   String?             // "PEA" | "CTO" - only for INVESTMENT type
  investmentStartDate DateTime?           // Investment start date (manual entry)
  taxTreatment        TaxTreatment        @default(TAXABLE) // INVESTMENT/CRYPTO only - see TaxTreatment
  taxRatePct          Float?              // 0-1 ratio, meaningful only when taxTreatment = TAXABLE
  loanAmountCents     BigInt?             // LOAN: initial borrowed amount
  loanTaeg            Float?              // LOAN: annual interest rate in % (e.g. 5.47)
  loanDurationMonths  Int?                // LOAN: total duration in months
  loanDeferralMonths  Int?                // LOAN: deferral period in months (0 = none)
  loanStartDate       DateTime?           // LOAN: repayment start date
  // LOAN: dedup flag for the "nearly paid off" alert - one-way, a loan only
  // crosses the threshold once. See lib/domain/alerts.ts.
  loanPaidOffAlertSent Boolean            @default(false)
  holdings            Holding[]
  history             HistoricalBalance[]
  transactions        Transaction[]
  recurringTransactions RecurringTransaction[]
  incomeEvents        IncomeEvent[]
  sales               Sale[]
  alertRules          AlertRule[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  gocardlessAccountId String?             @unique
  syncId              String?             @unique // e.g. "lcl:FR76XXXX" or "tr:ISIN"
}

model Holding {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticker         String
  name           String?
  quantity       Decimal  @db.Decimal(24, 10)
  lastPriceCents BigInt   @default(0)
  costBasisCents BigInt?  // total acquisition cost in cents (null = unknown)
  targetPct      Float?   // 0-1 ratio, target share of the account's total value - null means not part of the rebalancing plan
  currency             HoldingCurrency @default(EUR)
  nativePriceCents     BigInt?         // price as entered, in `currency` - null when currency = EUR (lastPriceCents IS the native price)
  nativeCostBasisCents BigInt?         // cost basis as entered, in `currency` - same null convention
  fxRateToEur          Float?          // EUR per 1 unit of `currency`, captured at entry time - null when currency = EUR
  alertRules     AlertRule[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([accountId, ticker])
}

model SyncLog {
  id        String   @id @default(cuid())
  source    String   // "lcl" | "trade_republic"
  status    String   // "success" | "error" | "auth_required"
  message   String?
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// Tracks, per sync source, whether it's currently in an unresolved broken
// streak - one row means "source has been failing since brokenSince, last
// alerted about it at lastAlertedAt". Deleted the moment that source syncs
// successfully again, so the *next* failure (if any) starts a brand new
// streak and alerts immediately rather than staying silently suppressed
// forever. Exists so checkSyncFailures() alerts once per streak (plus a
// reminder every REMINDER_INTERVAL_MS while it's still broken) instead of
// once per failed sync attempt - confirmed the hard way that the latter
// sends hundreds of emails within minutes once a source has been broken for
// a while (every failed attempt, whether from the 4h cron or repeated
// AutoSync-triggered retries, used to write its own SyncLog row that all
// got alerted on the very first check after being unblocked).
model SyncFailureState {
  source        String   @id
  brokenSince   DateTime @default(now())
  lastAlertedAt DateTime @default(now())
}

enum AlertRuleKind {
  ACCOUNT_BALANCE
  BUDGET_OVERRUN
  ACCOUNT_OVERDRAFT
  INVESTMENT_VALUE
  HOLDING_PRICE
  UNREALIZED_GAIN
}

enum GainUnit {
  PERCENT
  AMOUNT
}

// User-defined alert rules - a parallel mechanism alongside the 3 fixed
// v1.5 triggers on UserSettings (netWorthAlertThresholdCents et al.), which
// stay untouched - see CLAUDE.md's "Alerts & webhooks". One row per rule;
// `kind` decides which field group below is meaningful, same
// type-conditional-nullable-fields convention Account already uses for its
// LOAN/INVESTMENT-only fields - just shared across more than two kinds here.
model AlertRule {
  id      String        @id @default(cuid())
  kind    AlertRuleKind
  active  Boolean       @default(true)
  // Optional text appended to the generated alert body - null means just
  // the auto-generated sentence.
  message String?

  // Shared by ACCOUNT_BALANCE, ACCOUNT_OVERDRAFT, INVESTMENT_VALUE, and
  // HOLDING_PRICE, plus UNREALIZED_GAIN when gainUnit = AMOUNT - all the
  // exact same "current cents value crosses balanceThresholdCents"
  // edge-triggered shape (evaluateAccountBalanceAlert), just a different
  // source for "current" per kind (fiat balance, investment/crypto market
  // value, a single holding's price, or a computed gain) - kept as shared
  // columns rather than one pair per kind to avoid schema bloat for what's
  // mathematically the same comparison every time. The "balance"-flavored
  // names predate this reuse (ACCOUNT_BALANCE was the only kind that had
  // them) and were kept as-is rather than renamed, to avoid a risky
  // column-rename migration against already-deployed self-hosted installs'
  // real rule data. accountId is only ever null for UNREALIZED_GAIN (null =
  // aggregate across every investment/crypto account); every other kind
  // above requires a specific account, enforced in the create/update
  // action. onDelete: Cascade (not Transaction/RecurringTransaction's
  // SetNull-on-Category convention) - a rule whose account/holding/category
  // was deleted has no purpose left; a nulled-out rule would sit dead in
  // the list instead of just disappearing with it.
  accountId             String?
  account               Account?      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balanceThresholdCents BigInt?
  // Edge-triggered dedup, same semantics as UserSettings.netWorthAlertLastAbove
  // (null = never evaluated, fires only when the crossing direction flips).
  balanceLastAbove      Boolean?

  // HOLDING_PRICE only - a specific position's lastPriceCents (already
  // EUR-converted at entry time for foreign-currency holdings, see
  // Holding.fxRateToEur) crosses balanceThresholdCents, reusing the two
  // fields above for the actual comparison/dedup.
  holdingId String?
  holding   Holding? @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  // UNREALIZED_GAIN only, when gainUnit = PERCENT - gain/costBasis*100
  // crosses this instead of balanceThresholdCents. A separate field rather
  // than overloading balanceThresholdCents as "either cents or a raw
  // percent number", so a stored value's unit is never ambiguous.
  gainUnit         GainUnit?
  gainThresholdPct Float?

  // BUDGET_OVERRUN only. Threshold comes from Category.budgetCents itself,
  // not duplicated here.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  // Re-arms every calendar month, unlike the one-way loan flag or the
  // two-way balance/net-worth flip - stores which period ("YYYY-MM", UTC)
  // this rule last fired for, so a rule that fired in July can fire again
  // in August even though spend never "un-overran" in between.
  budgetOverrunLastFiredPeriod String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model HistoricalBalance {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  balanceCents BigInt
  recordedAt   DateTime @default(now())

  @@index([accountId, recordedAt])
}

model Transaction {
  id          String    @id @default(cuid())
  accountId   String
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  syncId      String    @unique // woob transaction id - used for deduplication
  date        DateTime
  label       String
  amountCents BigInt    // positive = credit, negative = debit
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  // GoCardless-only (PSD2's Berlin Group schema) - the card network's own
  // 4-digit merchant classification, when the account's bank actually
  // populates it (optional per the spec, so this is null for most
  // transactions - Woob/Trade Republic/CSV import never set it, they have
  // no equivalent field at all). See "Automatic categorization" in
  // CLAUDE.md: a more authoritative signal than free-text label matching
  // when present, since it's assigned by the card network at merchant
  // registration time rather than guessed from a label substring.
  merchantCategoryCode String?
  createdAt   DateTime  @default(now())
  // Reverse side of IncomeEvent.transactionId - lets "Mark as income"
  // (see IncomeEvent below) tell whether this transaction already has one,
  // so the same real-world payment can't be double-recorded.
  incomeEvent IncomeEvent?
  // Set by detectInternalTransferPairs (lib/domain/internal-transfers.ts)
  // when this transaction is matched with an opposite-signed transaction
  // of the same absolute amount on a different account within a few days -
  // a real gap found in production: a French bank's generic transfer
  // label ("VIREMENT SEPA") is reused for both internal transfers and real
  // external payments with no way to tell them apart from text alone, so
  // an internal transfer was getting auto-categorized as income. Once
  // flagged true, autoCategorizeTransactions never assigns it a category
  // automatically (it isn't real income or spending) - the flag doesn't
  // block a manual categorization, only the automatic sources.
  isInternalTransfer Boolean @default(false)

  @@index([accountId, date])
  @@index([categoryId])
  @@index([isInternalTransfer])
}

// EXPENSE is the default and by far the more common case (this app's
// budgeting concept has always meant spending) - INCOME is explicit,
// chosen at creation, never inferred from a category's transaction
// history. /budgets only ever lists EXPENSE categories (a "budget" cap
// has no meaning for income); /income lists INCOME categories alongside
// its own IncomeEvent-based dividend/interest tracking - see CLAUDE.md's
// "Interest & dividend income tracking" for why those stay two separate,
// parallel mechanisms rather than merging into one.
enum CategoryKind {
  EXPENSE
  INCOME
}

model Category {
  id                    String                 @id @default(cuid())
  name                  String                 @unique
  color                 String                 // hex, e.g. "#6366f1"
  kind                  CategoryKind           @default(EXPENSE)
  budgetCents           BigInt?                // monthly envelope - null means no budget set, and meaningless for an INCOME category (no cap concept for income)
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  alertRules            AlertRule[]
  createdAt             DateTime               @default(now())
}

enum RecurringFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id            String             @id @default(cuid())
  accountId     String
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label         String
  amountCents   BigInt             // positive = income, negative = expense
  categoryId    String?
  category      Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency     RecurringFrequency @default(MONTHLY)
  intervalCount Int                @default(1) // e.g. frequency=WEEKLY, intervalCount=2 → every 2 weeks
  anchorDate    DateTime           // a real known occurrence - day/weekday/month is derived from this
  active        Boolean            @default(true)
  autoDetected  Boolean            @default(false) // created by confirming a detected suggestion vs manually
  createdAt     DateTime           @default(now())

  @@index([accountId])
}

enum IncomeType {
  DIVIDEND
  INTEREST
}

model IncomeEvent {
  id               String     @id @default(cuid())
  accountId        String
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type             IncomeType
  ticker           String?    // e.g. "AAPL" - ties a DIVIDEND to a specific holding; null for INTEREST or an unattributed dividend
  amountCents      BigInt     // gross amount received
  taxWithheldCents BigInt?    // foreign withholding tax (e.g. 15% US treaty rate) - null means none withheld
  date             DateTime
  createdAt        DateTime   @default(now())
  // Set when this row was created via "Mark as income" from an actual
  // Transaction row (amount/date pre-filled from it) rather than typed
  // from scratch - null for pre-existing rows and for anyone who still
  // prefers the manual /income form. @unique so the same real payment can't
  // be marked as income twice. onDelete: SetNull, not Cascade: deleting the
  // source transaction (or its account) shouldn't destroy an already
  // fiscally-relevant income record - the record just loses its
  // provenance link.
  transactionId    String?     @unique
  transaction      Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([accountId, date])
}

model Sale {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ticker         String
  quantity       Decimal  @db.Decimal(24, 10)
  proceedsCents  BigInt   // gross sale proceeds
  costBasisCents BigInt   // cost basis of the sold portion (average-cost method)
  date           DateTime
  createdAt      DateTime @default(now())

  @@index([accountId, date])
}

model UserSettings {
  id                   String   @id @default("singleton")
  salaryNetCents       BigInt   @default(0)
  monthlyExpensesCents BigInt   @default(0)
  savingsGoalCents     BigInt   @default(5000000)
  monthlySavedCents    BigInt   @default(0)
  taxRatePea           Float    @default(0.172)
  taxRateCto           Float    @default(0.314)
  taxRateCrypto        Float    @default(0.314)
  // Base32 secret, plaintext - must stay reversible to keep generating
  // codes (unlike a password, there's no way to hash a TOTP secret). Same
  // no-field-level-encryption trust model as Institution.woobPassword.
  // Recovery if a self-hoster loses both their authenticator app and every
  // backup code: connect directly to the DB (psql/Prisma Studio) and set
  // totpEnabled=false, totpSecret=NULL - same "you have shell access to
  // your own server" recovery story as resetting AUTH_PASSWORD.
  totpSecret           String?
  totpEnabled          Boolean  @default(false)
  // bcrypt hashes, one per unused backup code - a consumed code is removed
  // from the array (not just flagged), so its length is also "codes remaining".
  totpBackupCodes      String[] @default([])
  // Alert channels - blank/null = that channel is disabled, same "leave
  // blank to disable" convention as every optional integration in
  // .env.example. smtpPassword is plaintext, same trust model as
  // totpSecret above.
  ntfyTopicUrl         String?
  // Bearer token for a self-hosted ntfy server with auth-default-access=deny-all
  // (see README's "Self-hosted alerts" section) - blank when pointed at the
  // public ntfy.sh anonymously, which has no auth to send.
  ntfyAuthToken        String?
  alertEmailTo         String?
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  smtpPassword         String?
  smtpFrom             String?
  // Net worth alert - blank threshold = disabled. netWorthAlertLastAbove is
  // dedup state (null = never evaluated yet): the alert only fires when the
  // crossing direction actually flips, not on every check while it stays
  // above/below.
  netWorthAlertThresholdCents BigInt?
  netWorthAlertLastAbove      Boolean?
  // Per-trigger opt-out for the two triggers that don't already have one -
  // net worth's off-switch is its blank threshold above. Default true so
  // existing installs keep today's behavior (both were always-on before
  // these fields existed).
  loanAlertsEnabled        Boolean  @default(true)
  syncFailureAlertsEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}

// Plaintext token, same trust model as UserSettings.totpSecret above - the
// point of a share link is being re-copied/re-shared later, so hashing it
// would force a "copy now or lose it forever" UX. Unguessability comes from
// entropy (32 random bytes, see lib/domain/share-links.ts), not from hiding
// it server-side.
model ShareLink {
  id             String    @id @default(cuid())
  token          String    @unique
  label          String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  lastAccessedAt DateTime?
  // Deliberate opt-in, default false: both surface more detail than the
  // dashboard-only view this link originally shipped with, and this link
  // may be reachable from the public internet - see "Read-only share links"
  // in CLAUDE.md. Set once at creation (createShareLink), no edit path -
  // same convention as label/expiresAt above.
  includeHoldings     Boolean @default(false)
  includeTransactions Boolean @default(false)
}

// Read-only REST API key (Settings -> API, see CLAUDE.md's "Public REST
// API") - deliberately its own model, not a reuse of ShareLink, even though
// both are unguessable-entropy bearer tokens: a ShareLink is meant for a
// specific other person to view a specific page, an ApiKey is meant for the
// owner's own tools (Home Assistant, a custom dashboard) to call a small
// set of JSON endpoints - different audience, different revocation
// granularity, conflating them would make either one's semantics fuzzy.
// token is plaintext, same trust model as ShareLink.token/
// UserSettings.totpSecret/Institution.woobPassword - the DB isn't hardened
// against server compromise, so hashing this one field buys little, and
// unlike a "shown once" GitHub-style token it needs to stay re-copyable
// (Settings -> API keeps a Copy button, no re-generation ceremony).
model ApiKey {
  id         String    @id @default(cuid())
  token      String    @unique
  label      String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
