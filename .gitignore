# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editor - per-machine state (extension settings/caches), never shared
/.vscode

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# database backups - contain personal financial data, never commit
/backups/*
!/backups/.gitkeep

# Python bytecode (sync/ service)
__pycache__/
*.pyc

# Claude Code
.claude/skills/**/__pycache__/
.claude/skills/**/*.pyc

# Local-only scratch notes (manual QA checklists etc.) - never pushed
/TEST_PROTOCOL.md
